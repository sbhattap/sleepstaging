# Environment and caches
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/
mne_data/

# Data: raw and processed files are rebuilt from PhysioNet (see data/README.md).
# Only the data docs, the download script and the generated data reports are tracked.
data/*
!data/README.md
!data/DATA_DICTIONARY.md
!data/data_quality.md
!data/download_sleepedf20.sh
!data/reports/
!data/splits/

# Model checkpoints and run logs
checkpoints/
*.ckpt
*.pt
logs/

# Experiment outputs (per-fold predictions, metrics, logs) are regenerated by `make exp1` ... `make exp4`;
# the summary table they feed (evaluation/summary.csv) is tracked.
results/

# Local working notes and archived experiments (not part of the project)
dev_notes/
archive/
